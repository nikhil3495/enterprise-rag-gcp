# Copy to .env for local overrides. Never commit .env.
# Default profile is fully offline (no credentials needed).
RAG_PROFILE=local

# --- prod-like local run against GCP (uses your ADC: `gcloud auth application-default login`)
# RAG_PROFILE=prod
# RAG_GCP_PROJECT=enterprise-rag-xxxxxx
# RAG_REGION=us-central1
# RAG_STATE_URI=gs://enterprise-rag-xxxxxx-rag-data/state
# RAG_VS_INDEX_ID=projects/123/locations/us-central1/indexes/456
# RAG_VS_ENDPOINT_ID=projects/123/locations/us-central1/indexEndpoints/789
# RAG_VS_DEPLOYED_INDEX_ID=rag_chunks_deployed
# RAG_VECTOR_BACKEND=memory          # low-cost fallback: in-memory index snapshotted to GCS

# --- models (Gemini on Vertex AI, global endpoint)
# RAG_GENERATION_MODEL=gemini-3.5-flash
# RAG_FAST_MODEL=gemini-3.5-flash-lite
# RAG_EMBEDDING_MODEL=gemini-embedding-001
# RAG_THINKING_LEVEL=LOW

# --- retrieval tuning
# RAG_CANDIDATE_K=30
# RAG_TOP_K=6
# RAG_RRF_ALPHA=0.6

# --- API auth (Cloud Run sets these via Terraform)
# RAG_AUTH_MODE=iam
# RAG_AUTH_AUDIENCE=https://rag-api-123.us-central1.run.app
# RAG_AUTH_ALLOWED_PRINCIPALS=you@example.com
